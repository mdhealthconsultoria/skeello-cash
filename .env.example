# Copie este arquivo para ".env" e preencha com as credenciais do SEU projeto Supabase
# (Project Settings > API no painel do Supabase).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Chave PÚBLICA de notificações push (gerada com a lib web-push).
# A chave PRIVADA correspondente fica só nos secrets da Edge Function send-push, nunca aqui.
VITE_VAPID_PUBLIC_KEY=sua-vapid-public-key
